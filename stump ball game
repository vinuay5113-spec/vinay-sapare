<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stump Game</title>
</head>
<body>
    <h1>This is a Stump Game</h1>
    <button onclick="playGame('bat')">Bat</button>
    <button onclick="playGame('ball')">Ball</button>
    <button onclick="playGame('stump')">Stump</button>

    <script>
        function playGame(userChoice) {
            console.log('You chose: ' + userChoice);
            let randomNumber = Math.floor(Math.random() * 3); // Generates 0, 1, or 2
            let computerChoice;

            // Determine computer choice based on random number
            if (randomNumber === 0) {
                computerChoice = 'bat';
            } else if (randomNumber === 1) {
                computerChoice = 'stump';
            } else {
                computerChoice = 'ball';
            }

            console.log('Computer chose: ' + computerChoice);
            determineWinner(userChoice, computerChoice);
        }

        function determineWinner(userChoice, computerChoice) {
            if (userChoice === computerChoice) {
                console.log("It's a tie!");
            } else if (
                (userChoice === 'bat' && computerChoice === 'ball') ||
                (userChoice === 'ball' && computerChoice === 'stump') ||
                (userChoice === 'stump' && computerChoice === 'bat')
            ) {
                console.log("You win!");
            } else {
                console.log("Computer wins!");
            }
        }
    </script>
</body>
</html>
